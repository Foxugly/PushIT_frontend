{
  "name": "pushit-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --no-hmr --proxy-config proxy.conf.json",
    "start:hmr": "ng serve --hmr --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage && node scripts/check-coverage.mjs",
    "e2e:serve": "node scripts/serve-dist.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.19",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^22.2.2",
    "@ctrl/ngx-emoji-mart": "^9.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@primeuix/themes": "^2.0.3",
    "@sentry/angular": "^10.76.1",
    "ngx-image-cropper": "^9.1.7",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^28.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}
