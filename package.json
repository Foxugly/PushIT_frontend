{
  "name": "pushit-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --no-hmr --proxy-config proxy.conf.json",
    "start:hmr": "ng serve --hmr --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --code-coverage && node scripts/check-coverage.mjs",
    "e2e:serve": "node scripts/serve-dist.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.27",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@angular/forms": "^20.3.27",
    "@angular/platform-browser": "^20.3.27",
    "@angular/router": "^20.3.27",
    "@ctrl/ngx-emoji-mart": "^9.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@primeuix/themes": "^2.0.3",
    "@sentry/angular": "^10.55.0",
    "ngx-image-cropper": "^9.1.6",
    "primeicons": "^7.0.0",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.27",
    "@playwright/test": "^1.54.2",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^28.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7"
  }
}
