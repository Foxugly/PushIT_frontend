# /etc/sudoers.d/pushit-frontend-deploy — installé par deploy/setup-server.sh.
#
# Least-privilege : `django` (utilisateur applicatif ET principal de déploiement)
# n'obtient QU'UN droit root : redémarrer l'unité oneshot qui re-lit la config
# SSM puis fait `nginx -t` + reload. L'unité exécute un script root-owned HORS de
# l'arbre applicatif (/usr/local/sbin/pushit-frontend-runtime-fetch.sh), donc
# `django` ne peut pas influencer le code exécuté en root. Aucune commande ici
# n'invoque un binaire/chemin inscriptible par django.
#
# Fichier en 0440 root:root ; valider avec `visudo -cf` avant de remplacer l'actif.
Cmnd_Alias PUSHIT_FRONTEND_DEPLOY = /usr/bin/systemctl restart pushit-frontend-runtime-fetch
Defaults!PUSHIT_FRONTEND_DEPLOY !setenv, !env_keep
django ALL=(root) NOPASSWD: PUSHIT_FRONTEND_DEPLOY
